# MagicLink 配置模板
#
# 用法：  cp .env.example .env     然后按需填写下面几项
#
# 几点说明：
#   · 本文件里的每一项都是【可选】的。一行都不填也能跑起来——
#     用户名 + 密码登录、直连抓取链接元信息、数据库放在项目根目录的 magiclink.db。
#   · 真正要改的只有「GitCode 登录」那一节，而且只有你想用 GitCode 登录时才需要。
#   · .env 已被 .gitignore 排除，不会进仓库；本模板（.env.example）才是要提交的那个。
#   · ⚠️ GITCODE_CLIENT_SECRET 是机密：只放 .env 里，不要写进任何会被提交的文件。
#   · 改完 .env 必须【重启服务】才生效——配置只在进程启动时读一次。
#   · PORT / HOST 不在这里配。它们是 ./run.sh 的参数，写进本文件不会生效：
#       ./run.sh 8080            # 换端口
#       ./run.sh --host 0.0.0.0  # 换监听地址
#       PORT=8080 ./run.sh       # 环境变量也行

# ── GitCode 登录（可选）──────────────────────────────────────────────────────
# 在 GitCode → 个人设置 → OAuth 应用 里创建，回调地址填：
#   http://127.0.0.1:3030/api/auth/gitcode/callback     （本地开发）
#   https://你的域名/api/auth/gitcode/callback           （部署后）
#
# 两个都填了才会启用；只填一个视为没配，界面上不显示 GitCode 入口。
GITCODE_CLIENT_ID=
GITCODE_CLIENT_SECRET=

# 申请什么权限。默认只申请 user_info（读用户资料），登录够用
# GITCODE_SCOPE=user_info

# ── 站点与网络 ──────────────────────────────────────────────────────────────
# 站点根地址。部署在反向代理后面时【务必设置】：
#   1) 拼 GitCode 回调地址（反代后面 uvicorn 推断不出对外的协议和域名）
#   2) 决定会话 cookie 要不要加 Secure —— 设成 https:// 才加。
#      不设的话 cookie 会在用户走到 http:// 时明文发出去；
#      但本地开发（http://127.0.0.1）也不能设，否则浏览器不存 cookie，登录会失败。
# MAGICLINK_BASE_URL=https://example.com

# 显式指定回调地址（优先级高于 MAGICLINK_BASE_URL）
# GITCODE_REDIRECT_URI=https://example.com/api/auth/gitcode/callback

# 抓取链接元信息 / 调 GitCode 时走代理。默认直连
# （httpx 默认会读系统的代理设置，但那样常指向没启动的代理软件，
#   所以这里默认 trust_env=False；确实要走代理就显式写这一行）
# MAGICLINK_PROXY=http://127.0.0.1:7890

# 数据库位置。默认项目根目录的 magiclink.db。
# 部署时建议放到代码目录之外，避免部署脚本 git reset --hard 影响数据。
# MAGICLINK_DB=/var/lib/magiclink/magiclink.db

# ── 仅测试用：把 GitCode 的三个地址指向别处（tests/test_gitcode.py 起假服务用）──
# GITCODE_AUTHORIZE_URL=
# GITCODE_TOKEN_URL=
# GITCODE_USER_API=
